{
	"name": "blinkguard",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"description": "A desktop application to help prevent dry eyes by reminding you to blink regularly",
	"author": {
		"name": "Pavlo Dzhevaha"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build && electron-builder",
		"build:electron": "tsc && vite build",
		"build:mac": "npm run build:electron && node scripts/remove-quarantine.js && electron-builder --mac",
		"build:mac:clean": "npm run build:mac && node scripts/remove-quarantine.js --clean-dmg",
		"build:windows": "node scripts/prepare-python-windows.js && tsc && vite build && electron-builder --win nsis --config.win.signAndEditExecutable=false",
		"remove-quarantine": "node scripts/remove-quarantine.js",
		"remove-quarantine:dmg": "node scripts/remove-quarantine.js --clean-dmg",
		"lint": "npx @biomejs/biome check --write src",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.0",
		"@radix-ui/react-slot": "^1.1.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"electron-store": "^11.0.2",
		"lottie-web": "^5.13.0",
		"lucide-react": "^1.29.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@electron/notarize": "^3.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.0.1",
		"@types/node": "^22.5.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"dotenv": "^17.4.2",
		"electron": "^43.3.0",
		"electron-builder": "^26.15.3",
		"happy-dom": "^20.11.1",
		"postcss": "^8.4.47",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.2.2",
		"vite": "^8.2.1",
		"vite-plugin-electron": "^1.1.1",
		"vitest": "^4.1.10"
	},
	"main": "dist-electron/main.js",
	"build": {
		"appId": "com.xpogx.blinkguard",
		"productName": "BlinkGuard",
		"publish": null,
		"artifactName": "${productName}-${arch}.${ext}",
		"files": [
			"dist/**/*",
			"!dist/win-unpacked/**/*",
			"!dist/*.exe",
			"!dist/*.blockmap",
			"!dist/*.zip",
			"!dist/*.yml",
			"dist-electron/**/*",
			"electron/assets/models/**/*",
			"electron/resources/**/*",
			"assets/icons/**/*",
			"build/**/*",
			"public/sounds/**/*"
		],
		"asarUnpack": [
			"electron/assets/models/**/*",
			"electron/resources/**/*",
			"public/sounds/**/*"
		],
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "BlinkGuard",
			"installerIcon": "assets/icons/icon.ico",
			"uninstallerIcon": "assets/icons/icon.ico",
			"installerHeaderIcon": "assets/icons/icon.ico",
			"deleteAppDataOnUninstall": false,
			"displayLanguageSelector": false,
			"installerLanguages": [
				"en-US"
			],
			"language": "1033",
			"artifactName": "BlinkGuard.Setup.${ext}"
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.utilities",
			"icon": "assets/icons/icon.icns",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": true,
			"artifactName": "BlinkGuard-${arch}.${ext}"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				"zip"
			],
			"icon": "assets/icons/icon.ico"
		}
	}
}
